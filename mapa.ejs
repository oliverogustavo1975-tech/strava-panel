function resCoord(r){
  var u=r.ubicacion_maps_url||"",t=r.ubicacion_texto||"";
  var c=parseCoords(u); if(c) return {lat:c[0],lng:c[1],approx:false,etq:(t||"coordenadas")};
  var gu=GEO[norm(u)]; if(gu) return {lat:gu[0],lng:gu[1],approx:true,etq:(u||t)};
  c=parseCoords(t); if(c) return {lat:c[0],lng:c[1],approx:false,etq:(t||"coordenadas")};
