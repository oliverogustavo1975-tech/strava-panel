  if(!lats.length){lats=[-34.9,-30.1];lngs=[-58.4,-53.1];}
  var minLa=Math.min.apply(null,lats),maxLa=Math.max.apply(null,lats),minLo=Math.min.apply(null,lngs),maxLo=Math.max.apply(null,lngs);
  var pLa=Math.max((maxLa-minLa)*0.08,0.2),pLo=Math.max((maxLo-minLo)*0.08,0.2);
  minLa-=pLa;maxLa+=pLa;minLo-=pLo;maxLo+=pLo;
  var mid=(minLa+maxLa)/2,k=Math.cos(mid*Math.PI/180);
  var X=function(lng){return (lng-minLo)*k;},Y=function(lat){return (maxLa-lat);};
  var bw=X(maxLo)||1,bh=Y(minLa)||1,VBW=1000,VBH=Math.max(300,Math.min(820,Math.round(1000*bh/bw)));
