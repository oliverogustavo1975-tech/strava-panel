function coordPais(lat,lng){ if(lng<-58.6) return "argentina"; if(lng>-53.6&&lat>-33.9) return "brasil"; return "uruguay"; }

var S={tx:0,ty:0,s:1,sel:null,vbw:1000,vbh:640,focus:"todos",proj:null,data:null,groups:null};

function buildPoints(){
  var out=[],sin=[];
  (window.__RECURSOS__||[]).forEach(function(r){
    if(r.tipo!=="grua"&&r.tipo!=="camion"&&r.tipo!=="remolque") return;
    var c=resCoord(r);
