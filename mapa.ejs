<%- include('partials/top', { titulo: 'Mapa', tag: 'Ubicación de la flota — grúas, camiones y remolques', activo: 'mapa', ruta: '/mapa' }) %>
<style>
#mapa-root{max-width:1180px;margin:0 auto;}
.mco-note{font-size:13px;color:#33424f;background:#EEF2F6;border:1px solid #D6DEE6;border-radius:10px;padding:10px 12px;margin:14px 0 10px;}
.mco-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:8px;}
.mco-seg{display:flex;flex-wrap:wrap;border:1px solid #C9D2DA;border-radius:8px;overflow:hidden;}
.mco-seg button{border:none;background:#fff;color:#33424f;padding:7px 12px;font-size:12.5px;cursor:pointer;border-right:1px solid #C9D2DA;font-family:inherit;}
.mco-seg button:last-child{border-right:none;}
.mco-seg button.active{background:#1F3A5C;color:#fff;font-weight:600;}
.mco-legend{display:flex;gap:6px 14px;flex-wrap:wrap;font-size:11.5px;color:#5C6B7A;margin-bottom:8px;}
.mco-panel{font-size:13px;background:#F7F9FB;border:1px solid #D6DEE6;border-radius:10px;padding:10px 12px;margin-top:10px;min-height:40px;}
.mco-panhead{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;}
.mco-row{display:flex;justify-content:space-between;align-items:center;gap:8px;border:1px solid #E1E7ED;background:#fff;border-radius:8px;padding:7px 10px;margin-top:6px;font-size:12.5px;}
.mco-muted{color:#7A8794;font-size:11px;}
.mco-pill{display:inline-flex;align-items:center;padding:2px 9px;border-radius:99px;font-size:11px;font-weight:600;white-space:nowrap;}
.mco-disponible{background:#E1F8EA;color:#14A04A;}
.mco-ocupado{background:#FBEEDD;color:#C8720A;}
.mco-mantenimiento{background:#EEECE7;color:#6B6357;}
.mco-baja{background:#F8E6E3;color:#C0392B;}
.mco-btn{border:1px solid #C9D2DA;background:#fff;border-radius:7px;padding:3px 9px;font-size:12px;cursor:pointer;font-family:inherit;color:#33424f;}
.mco-warn{font-size:12.5px;color:#33424f;background:#FBF3E6;border:1px solid #EBD9B8;border-left:4px solid #C8720A;border-radius:10px;padding:10px 12px;margin-top:12px;}
.mco-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
.mco-chip{background:#EEF2F6;border:1px solid #D6DEE6;border-radius:7px;padding:4px 9px;font-size:12px;color:#33424f;}
</style>
