function zoomAt(cx,cy,f){var ns=Math.max(1,Math.min(16,S.s*f)),k=ns/S.s;S.tx=cx-(cx-S.tx)*k;S.ty=cy-(cy-S.ty)*k;S.s=ns;if(S.s<=1.001){S.s=1;S.tx=0;S.ty=0;}applyTransform();}
