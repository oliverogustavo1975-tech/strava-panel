  svg.addEventListener("pointermove",function(e){if(!down)return;var r=svg.getBoundingClientRect();S.tx+=(e.clientX-lx)/r.width*S.vbw;S.ty+=(e.clientY-ly)/r.height*S.vbh;lx=e.clientX;ly=e.clientY;applyTransform();});
