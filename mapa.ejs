      +'<text data-mk="dottext" x="'+g.x.toFixed(1)+'" y="'+(g.y+4.5).toFixed(1)+'" font-size="13" text-anchor="middle" fill="#fff" font-weight="700" style="pointer-events:none">'+esc(String(label))+'</text></g>';
  }).join("");
  host.innerHTML='<svg id="mapa-svg" viewBox="0 0 '+S.vbw+' '+S.vbh+'" width="100%" style="display:block;height:60vh;min-height:360px;background:#fff;border:1px solid #C9D2DA;border-radius:12px;touch-action:none;cursor:grab;overflow:hidden;">'
    +'<g id="mapa-scene">'+paths+refDots+markers+'</g></svg>';
  S.s=1;S.tx=0;S.ty=0; applyTransform(); wireZoom();
  if(S.sel&&!groups.some(function(g){return g.key===S.sel;}))S.sel=null;
  renderPanel();
}
function renderPanel(){
  var el=document.getElementById("mapa-panel"); if(!el) return;
  if(!S.sel){el.innerHTML='<span style="color:#5C6B7A;font-size:13px;">Tocá un punto del mapa para ver qué equipos hay ahí.</span>';return;}
  var g=(S.groups||[]).find(function(x){return x.key===S.sel;}); if(!g){el.innerHTML="";return;}
  var rows=g.items.slice().sort(function(a,b){return (a.nombre||"").localeCompare(b.nombre||"","es",{numeric:true});}).map(function(r){
    var st=r.status||{code:"disponible",label:""};
