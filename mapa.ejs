function sinPorTipo(sin){var c={grua:0,camion:0,remolque:0};sin.forEach(function(r){if(c[r.tipo]!=null)c[r.tipo]++;});var p=[];["grua","camion","remolque"].forEach(function(t){if(c[t])p.push(c[t]+" "+(t==="grua"?"grúas":t==="camion"?"camiones":"remolques"));});return p.join(" · ");}

window.MapaCO={
  focus:function(p){S.focus=p;S.sel=null;dibujar();var seg=document.getElementById("mco-focus");if(seg){var b=seg.querySelectorAll("button");for(var i=0;i<b.length;i++)b[i].classList.remove("active");var idx={todos:0,uruguay:1,argentina:2,brasil:3}[p];if(b[idx])b[idx].classList.add("active");}},
  open:function(k){S.sel=k;renderPanel();},
  zoom:function(f){zoomAt(S.vbw/2,S.vbh/2,f);},
  reset:function(){S.s=1;S.tx=0;S.ty=0;applyTransform();},
  init:function(){
    var root=document.getElementById("mapa-root"); if(!root) return;
    var data=buildPoints(); S.data=data;
    var cnt=countByPais(data),tot=data.pts.length;
    var fb=[["todos","🌎 Todos ("+tot+")"]].concat(["uruguay","argentina","brasil"].map(function(p){return [p,PFLAG[p]+" "+PNAME[p]+" ("+cnt[p]+")"];}))
      .map(function(kv){return '<button class="'+(S.focus===kv[0]?"active":"")+'" onclick="MapaCO.focus(\''+kv[0]+'\')">'+kv[1]+'</button>';}).join("");
    root.innerHTML=
      '<div class="mco-note">🗺 Equipos por ubicación sobre el mapa de Uruguay, Argentina y Brasil. Mostrando <strong>'+tot+'</strong> equipo'+(tot===1?"":"s")+' ubicado'+(tot===1?"":"s")+'. Arrastrá para mover, rueda o pellizco para zoom. Un punto con número agrupa varios equipos — tocalo para verlos.</div>'
      +'<div class="mco-bar"><div class="mco-seg" id="mco-focus">'+fb+'</div><div class="mco-seg"><button onclick="MapaCO.zoom(1.3)">＋</button><button onclick="MapaCO.zoom(1/1.3)">−</button><button onclick="MapaCO.reset()">⤢ Ver todo</button></div></div>'
      +'<div class="mco-legend"><span>🟩 disponible</span><span>🟧 ocupado</span><span>⬛ mantenim.</span><span>🟥 baja</span><span>🔵 varios equipos (número)</span></div>'
      +'<div id="mapa-svg-host"></div>'
      +'<div id="mapa-panel" class="mco-panel"></div>'
      +(data.sin.length?'<div class="mco-warn"><strong>⚠ '+data.sin.length+' equipos sin ubicación cargada</strong> — no se pueden poner en el mapa hasta cargarles una localidad o coordenada (ficha del equipo → ubicación). '+esc(sinPorTipo(data.sin))+'.</div>'
         +'<div class="mco-chips">'+data.sin.slice().sort(function(a,b){return (a.nombre||"").localeCompare(b.nombre||"","es",{numeric:true});}).map(function(r){return '<span class="mco-chip">'+tipoIcon(r.tipo)+' '+esc(r.nombre)+'</span>';}).join("")+'</div>':"");
    dibujar();
  }
};
if(document.readyState==="loading") document.addEventListener("DOMContentLoaded",window.MapaCO.init);
else window.MapaCO.init();
})();
</script>
