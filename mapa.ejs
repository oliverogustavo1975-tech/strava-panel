function tipoIcon(t){return t==="grua"?"🏗":t==="camion"?"🚚":t==="remolque"?"🔗":"•";}
function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];});}
function norm(s){return String(s==null?"":s).toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g,"").replace(/\s+/g," ").trim();}
function parseCoords(str){
  var v=String(str==null?"":str).trim(); if(!v) return null;
  if(/^https?:\/\//i.test(v)||/goo\.gl|maps\./i.test(v)){var m0=v.match(/@?(-?\d{1,3}\.\d+)[, ]+(-?\d{1,3}\.\d+)/);return m0?[parseFloat(m0[1]),parseFloat(m0[2])]:null;}
