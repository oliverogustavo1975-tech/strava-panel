}
function focusPoints(pts,focus){
  if(focus==="todos"){ return pts.length?pts.map(function(p){return [p.c.lat,p.c.lng];}):(COUNTRIES.uruguay[0]||[]).slice(); }
  var fp=(COUNTRIES[focus]&&COUNTRIES[focus][0]?COUNTRIES[focus][0].slice():[]);
  pts.filter(function(p){return p.pais===focus;}).forEach(function(p){fp.push([p.c.lat,p.c.lng]);});
  return fp.length?fp:(COUNTRIES.uruguay[0]||[]);
}
function groupPoints(pts,proj){
  var g={};
  pts.forEach(function(p){var k=p.c.lat.toFixed(3)+","+p.c.lng.toFixed(3);(g[k]=g[k]||{lat:p.c.lat,lng:p.c.lng,approx:p.c.approx,etq:p.c.etq,items:[]}).items.push(p.r);if(!p.c.approx)g[k].approx=false;});
  return Object.keys(g).map(function(k){var o=g[k];var xy=proj(o.lat,o.lng);o.x=xy[0];o.y=xy[1];o.key=k;return o;});
}
function applyTransform(){
  var g=document.getElementById("mapa-scene"); if(!g) return;
  g.setAttribute("transform","translate("+S.tx+","+S.ty+") scale("+S.s+")");
  var r=11/S.s,f=13/S.s,n=g.querySelectorAll("[data-mk]");
  for(var i=0;i<n.length;i++){var el=n[i],kind=el.getAttribute("data-mk");
    if(kind==="dot")el.setAttribute("r",r);else if(kind==="ref")el.setAttribute("r",3/S.s);
    else if(kind==="reftext")el.setAttribute("font-size",12/S.s);else if(kind==="dottext")el.setAttribute("font-size",f);}
}
function dibujar(){
  var host=document.getElementById("mapa-svg-host"); if(!host) return;
  var focus=S.focus,data=S.data;
  var shown=(focus==="todos")?data.pts.slice():data.pts.filter(function(p){return p.pais===focus;});
  var proj=makeProjection(focusPoints(data.pts,focus)); S.proj=proj;
  var groups=groupPoints(shown,proj); S.groups=groups;
  var paths="";
  ["brasil","argentina","uruguay"].forEach(function(cp){
    var fill=(focus==="todos"||focus===cp)?"#DCE7F2":"#EDF1F5",op=(focus==="todos"||focus===cp)?"0.95":"0.6";
    (COUNTRIES[cp]||[]).forEach(function(ring){
      var d=ring.map(function(q,i){var p=proj(q[0],q[1]);return (i?"L":"M")+p[0].toFixed(1)+" "+p[1].toFixed(1);}).join(" ")+" Z";
      paths+='<path d="'+d+'" fill="'+fill+'" fill-opacity="'+op+'" stroke="#1F3A5C" stroke-width="1.4" stroke-linejoin="round" vector-effect="non-scaling-stroke"/>';
    });
  });
  var refs=(focus==="todos"?["uruguay","argentina","brasil"]:[focus]);
  var refDots=refs.reduce(function(a,cp){return a.concat(REF[cp]||[]);},[]).map(function(rf){var p=proj(rf[1],rf[2]);
    return '<circle data-mk="ref" cx="'+p[0].toFixed(1)+'" cy="'+p[1].toFixed(1)+'" r="3" fill="#7A8794" opacity="0.8"/>'
      +'<text data-mk="reftext" x="'+(p[0]+6).toFixed(1)+'" y="'+(p[1]+4).toFixed(1)+'" font-size="12" fill="#5C6B7A" style="pointer-events:none">'+esc(rf[0])+'</text>';}).join("");
