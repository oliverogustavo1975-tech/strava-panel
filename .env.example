# Copiar a .env para desarrollo local, y cargar las mismas claves como
# variables de entorno en Render (nunca subir .env real a GitHub).

# Local: postgresql://torre:torre_dev_pw@localhost:5432/torre_dev
# Render: Render te da esta URL sola al crear una base Postgres (Internal Database URL).
DATABASE_URL="postgresql://torre:torre_dev_pw@localhost:5432/torre_dev"

PORT=3000
