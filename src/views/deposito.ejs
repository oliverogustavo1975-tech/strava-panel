<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Torre — Depósito</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div class="brand">
      <h1>🏗️ Torre</h1>
      <div class="tag">Depósito — ingresa y sale solo con los fletes</div>
    </div>
    <nav class="nav">
      <a class="nav-link" href="/recursos">Recursos</a>
      <a class="nav-link" href="/trabajos">Trabajos</a>
      <a class="nav-link" href="/fletes">Fletes</a>
      <a class="nav-link active" href="/deposito">Depósito</a>
    </nav>
    <div class="topbar-actions">
      <% if (isAdmin) { %>
        <form method="post" action="/logout" class="inline-form"><button class="btn btn-ghost btn-sm" type="submit">Salir</button></form>
      <% } else { %>
        <a class="btn btn-ghost btn-sm" href="/login">Ingresar</a>
      <% } %>
    </div>
    <div class="gen-note">Actualizado: <%= generatedAt.toLocaleString("es-UY") %></div>
  </div>

  <div class="section-title">En depósito · <%= dentro.length %></div>
  <% if (!dentro.length) { %><div class="empty">No hay piezas en el depósito.</div><% } %>
  <div class="flete-list">
    <% dentro.forEach(function(d){ %>
    <div class="flete-card">
      <div class="flete-top">
        <div>
          <div class="job-title"><%= d.componente || "Sin nombre" %></div>
          <div class="flete-sub"><%= d.cliente || "Sin cliente" %><%= d.numero_serie ? " · Serie " + d.numero_serie : "" %></div>
        </div>
        <span class="pill pill-disponible"><span class="dot" style="background:currentColor"></span>En depósito</span>
      </div>
      <div class="flete-detail">
        <span><strong>Ingresó:</strong> <%= d.fecha_ingreso ? new Date(d.fecha_ingreso).toLocaleString("es-UY") : "Sin fecha" %></span>
        <% if (d.procedencia) { %><span><strong>Procedencia:</strong> <%= d.procedencia %></span><% } %>
      </div>
      <% if (d.notas) { %><div class="job-notas"><%= d.notas %></div><% } %>
    </div>
    <% }); %>
  </div>

  <div class="section-title">Salidas (historial) · <%= salidos.length %></div>
  <div class="flete-list">
    <% salidos.forEach(function(d){ %>
    <div class="flete-card">
      <div class="flete-top">
        <div>
          <div class="job-title"><%= d.componente || "Sin nombre" %></div>
          <div class="flete-sub"><%= d.cliente || "Sin cliente" %><%= d.numero_serie ? " · Serie " + d.numero_serie : "" %></div>
        </div>
        <span class="pill pill-baja"><span class="dot" style="background:currentColor"></span>Salió</span>
      </div>
      <div class="flete-detail">
        <span><strong>Ingresó:</strong> <%= d.fecha_ingreso ? new Date(d.fecha_ingreso).toLocaleString("es-UY") : "Sin fecha" %></span>
        <span><strong>Salió:</strong> <%= new Date(d.fecha_egreso).toLocaleString("es-UY") %></span>
        <% if (d.destino) { %><span><strong>Destino:</strong> <%= d.destino %></span><% } %>
      </div>
    </div>
    <% }); %>
  </div>
</div>
</body>
</html>
