<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Torre — <%= isNew ? "Nuevo flete" : "Editar flete" %></title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrap wrap-narrow">
  <div class="form-card">
    <h2><%= isNew ? "Nuevo flete" : "Editar flete" %></h2>
    <form method="post" action="<%= isNew ? '/fletes' : '/fletes/' + f.id %>">
      <label class="field">
        <span>Componente</span>
        <input type="text" name="componente" value="<%= f.componente || '' %>">
      </label>
      <label class="field">
        <span>Número de serie</span>
        <input type="text" name="numero_serie" value="<%= f.numero_serie || '' %>">
      </label>
      <label class="field">
        <span>Cliente</span>
        <input type="text" name="cliente" value="<%= f.cliente || '' %>">
      </label>
      <label class="field">
        <span>Solicitante</span>
        <input type="text" name="solicitante" value="<%= f.solicitante || '' %>">
      </label>
      <label class="field">
        <span>Contacto del solicitante</span>
        <input type="text" name="solicitante_contacto" value="<%= f.solicitante_contacto || '' %>">
      </label>
      <label class="field">
        <span>Trabajo asociado</span>
        <select name="trabajo_id">
          <option value="">Sin asociar</option>
          <% jobs.forEach(function(j){ %>
          <option value="<%= j.id %>" <%= f.trabajo_id===j.id?'selected':'' %>><%= j.titulo %></option>
          <% }); %>
        </select>
      </label>
      <label class="field">
        <span>Fecha</span>
        <input type="datetime-local" name="fecha" value="<%= toInputLocal(f.fecha) %>">
      </label>
      <label class="field">
        <span>Origen (texto)</span>
        <input type="text" name="origen_texto" value="<%= f.origen_texto || '' %>">
      </label>
      <label class="field">
        <span>Origen (link de Maps)</span>
        <input type="text" name="origen_maps_url" value="<%= f.origen_maps_url || '' %>">
      </label>
      <label class="field">
        <span>Destino (texto)</span>
        <input type="text" name="destino_texto" value="<%= f.destino_texto || '' %>">
      </label>
      <label class="field">
        <span>Destino (link de Maps)</span>
        <input type="text" name="destino_maps_url" value="<%= f.destino_maps_url || '' %>">
      </label>
      <label class="field">
        <span>Camión</span>
        <select name="camion_id">
          <option value="">Sin asignar</option>
          <% groups.camion.forEach(function(r){ %>
          <option value="<%= r.id %>" <%= f.camion_id===r.id?'selected':'' %>><%= r.nombre %><%= r.identificador ? ' · '+r.identificador : '' %></option>
          <% }); %>
        </select>
      </label>
      <label class="field">
        <span>Remolque</span>
        <select name="remolque_id">
          <option value="">Sin asignar</option>
          <% groups.remolque.forEach(function(r){ %>
          <option value="<%= r.id %>" <%= f.remolque_id===r.id?'selected':'' %>><%= r.nombre %><%= r.identificador ? ' · '+r.identificador : '' %></option>
          <% }); %>
        </select>
      </label>
      <label class="field">
        <span>Chofer</span>
        <select name="chofer_id">
          <option value="">Sin asignar</option>
          <% groups.operario.forEach(function(r){ %>
          <option value="<%= r.id %>" <%= f.chofer_id===r.id?'selected':'' %>><%= r.nombre %></option>
          <% }); %>
        </select>
      </label>
      <label class="check">
        <input type="checkbox" name="necesita_grua" value="on" id="necesita_grua" <%= f.necesita_grua?'checked':'' %>> Necesita grúa
      </label>
      <label class="field">
        <span>Grúa</span>
        <select name="grua_id">
          <option value="">Sin asignar</option>
          <% groups.grua.forEach(function(r){ %>
          <option value="<%= r.id %>" <%= f.grua_id===r.id?'selected':'' %>><%= r.nombre %><%= r.identificador ? ' · '+r.identificador : '' %></option>
          <% }); %>
        </select>
      </label>
      <label class="field">
        <span>Peso de carga (t)</span>
        <input type="number" step="0.1" name="peso_carga_t" value="<%= f.peso_carga_t ?? '' %>">
      </label>
      <label class="field">
        <span>Ancho (m)</span>
        <input type="number" step="0.1" name="medida_ancho_m" value="<%= f.medida_ancho_m ?? '' %>">
      </label>
      <label class="field">
        <span>Largo (m)</span>
        <input type="number" step="0.1" name="medida_largo_m" value="<%= f.medida_largo_m ?? '' %>">
      </label>
      <label class="field">
        <span>Distancia (km)</span>
        <input type="number" step="0.1" name="distancia_km" value="<%= f.distancia_km ?? '' %>">
      </label>
      <label class="field">
        <span>Viajes de movilización</span>
        <input type="number" name="viajes_movilizacion_total" value="<%= f.viajes_movilizacion_total ?? '' %>">
      </label>
      <label class="field">
        <span>Fecha de llegada</span>
        <input type="datetime-local" name="fecha_llegada" value="<%= toInputLocal(f.fecha_llegada) %>">
      </label>
      <label class="field">
        <span>Nota de llegada</span>
        <input type="text" name="llegada_nota" value="<%= f.llegada_nota || '' %>">
      </label>
      <label class="field">
        <span>Notas</span>
        <textarea name="notas" rows="3"><%= f.notas || '' %></textarea>
      </label>

      <div class="form-actions">
        <button class="btn btn-primary" type="submit"><%= isNew ? "Crear flete" : "Guardar cambios" %></button>
        <a class="btn btn-ghost" href="/fletes">Cancelar</a>
      </div>
    </form>

    <% if (!isNew) { %>
    <form method="post" action="/fletes/<%= f.id %>/eliminar" class="delete-form" onsubmit="return confirm('¿Eliminar este flete? No se puede deshacer.');">
      <button class="btn btn-danger" type="submit">Eliminar flete</button>
    </form>
    <% } %>
  </div>
</div>
</body>
</html>
