<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Central de Operaciones — Fletes</title>
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="wrap">
  <div class="topbar">
    <div class="brand">
      <h1>Central de Operaciones</h1>
      <div class="tag">Fletes — traslados de componentes y equipos</div>
    </div>
    <nav class="nav">
      <a class="nav-link" href="/recursos">Recursos</a>
      <a class="nav-link" href="/trabajos">Trabajos</a>
      <a class="nav-link active" href="/fletes">Fletes</a>
      <a class="nav-link" href="/deposito">Depósito</a>
      <a class="nav-link" href="/personal">Personal</a>
    </nav>
    <div class="topbar-actions">
      <% if (isAdmin) { %>
        <a class="btn btn-primary btn-sm" href="/fletes/nuevo">+ Nuevo flete</a>
        <form method="post" action="/logout" class="inline-form"><button class="btn btn-ghost btn-sm" type="submit">Salir</button></form>
      <% } else { %>
        <a class="btn btn-ghost btn-sm" href="/login">Ingresar</a>
      <% } %>
    </div>
    <div class="gen-note">Actualizado: <%= generatedAt.toLocaleString("es-UY") %></div>
  </div>

  <div class="section-title">Fletes · <%= fletes.length %></div>
  <% if (!fletes.length) { %>
    <div class="empty">Todavía no hay fletes cargados.</div>
  <% } %>

  <div class="flete-list">
    <% fletes.forEach(function(f){ %>
    <div class="flete-card">
      <div class="flete-top">
        <div>
          <div class="job-title"><%= f.componente || "Sin componente" %></div>
          <div class="flete-sub"><%= f.cliente || "Sin cliente" %><%= f.trabajoTitulo ? " · " + f.trabajoTitulo : "" %></div>
        </div>
        <div class="res-top-right">
          <span class="pill pill-<%= f.llegado ? "disponible" : "ocupado" %>">
            <span class="dot" style="background:currentColor"></span><%= f.llegado ? "Llegó" : "En tránsito / pendiente" %>
          </span>
          <% if (isAdmin) { %><a class="edit-link" href="/fletes/<%= f.id %>/editar">Editar</a> <a class="edit-link" href="/fletes/nuevo?copiar=<%= f.id %>">Duplicar</a>
          <% if (!f.deposito_ingreso_id) { %><form method="post" action="/fletes/<%= f.id %>/copiar-deposito" class="inline-form"><button class="edit-link linkbtn" type="submit">Copiar al depósito</button></form><% } %><% } %>
        </div>
      </div>
      <div class="flete-route">
        <span><%= f.origen_texto || "Origen sin definir" %></span>
        <span class="arrow">→</span>
        <span><%= f.destino_texto || "Destino sin definir" %></span>
      </div>
      <% if (f.origen_maps_url || f.destino_maps_url) { %>
      <div class="flete-mapas">
        <% if (f.origen_maps_url) { %><a href="<%= f.origen_maps_url %>" target="_blank" rel="noopener">📍 Ubicación del origen</a><% } %>
        <% if (f.destino_maps_url) { %><a href="<%= f.destino_maps_url %>" target="_blank" rel="noopener">📍 Ubicación del destino</a><% } %>
      </div>
      <% } %>
      <div class="flete-detail">
        <span><strong>Fecha:</strong> <%= f.fecha ? new Date(f.fecha).toLocaleString("es-UY") : "Sin definir" %></span>
        <% if (f.camionNombre) { %><span><strong>Camión:</strong> <%= f.camionNombre %></span><% } %>
        <% if (f.remolqueNombre) { %><span><strong>Remolque:</strong> <%= f.remolqueNombre %></span><% } %>
        <% if (f.choferNombre) { %><span><strong>Chofer:</strong> <%= f.choferNombre %></span><% } %>
        <% if (f.necesita_grua && f.gruaNombre) { %><span><strong>Grúa:</strong> <%= f.gruaNombre %></span><% } %>
        <% if (f.peso_carga_t) { %><span><strong>Peso:</strong> <%= f.peso_carga_t %> t</span><% } %>
        <% if (f.km_recorridos) { %><span><strong>Km:</strong> <%= f.km_recorridos %></span><% } %>
        <% if (f.combustible_litros) { %><span><strong>Combustible:</strong> <%= f.combustible_litros %> L</span><% } %>
        <% if (f.combustible_costo) { %><span><strong>Gasto combustible:</strong> <%= f.combustible_costo %></span><% } %>
      </div>
      <% if (f.notas) { %><div class="job-notas"><%= f.notas %></div><% } %>
    </div>
    <% }); %>
  </div>
</div>
</body>
</html>
